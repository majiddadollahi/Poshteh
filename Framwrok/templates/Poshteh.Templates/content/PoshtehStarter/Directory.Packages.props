<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Version of the Poshteh framework packages; keep all Poshteh.* packages on the same version. -->
    <PoshtehFrameworkVersion>10.0.1</PoshtehFrameworkVersion>
    <!-- Lets the PackageVersion entries below override vulnerable transitive dependencies. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Poshteh.Core.Domain" Version="$(PoshtehFrameworkVersion)" />
    <PackageVersion Include="Poshteh.Core.Contract" Version="$(PoshtehFrameworkVersion)" />
    <PackageVersion Include="Poshteh.Core.ApplicationService" Version="$(PoshtehFrameworkVersion)" />
    <PackageVersion Include="Poshteh.Infra.Data.Sql.Command" Version="$(PoshtehFrameworkVersion)" />
    <PackageVersion Include="Poshteh.Infra.Data.Sql.Query" Version="$(PoshtehFrameworkVersion)" />
    <PackageVersion Include="Poshteh.Endpoint.Api" Version="$(PoshtehFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive via Poshteh.Infra.Data.Sql.Command -> EF Core SqlServer -> Microsoft.Data.SqlClient,
         which brings 9.0.11 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
