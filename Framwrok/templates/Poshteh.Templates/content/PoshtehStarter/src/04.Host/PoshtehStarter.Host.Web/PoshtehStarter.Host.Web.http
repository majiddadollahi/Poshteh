@host = http://localhost:5080

### Create
POST {{host}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "items": [
    { "productName": "Mechanical Keyboard", "unitPrice": 120.50, "quantity": 1 },
    { "productName": "USB-C Hub", "unitPrice": 35.00, "quantity": 2 }
  ]
}

### Get by id
GET {{host}}/api/orders/1

### List with filters, sorting and paging
GET {{host}}/api/orders?customerName=Ada&productName=Hub&sortBy=CreatedDate&descending=true&page=1&pageSize=10

### Update
PUT {{host}}/api/orders/1
Content-Type: application/json

{
  "customerName": "Ada King",
  "items": [
    { "productName": "Mechanical Keyboard", "unitPrice": 110.00, "quantity": 2 }
  ]
}

### Delete
DELETE {{host}}/api/orders/1
