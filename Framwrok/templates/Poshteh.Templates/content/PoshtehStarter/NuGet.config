<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Poshteh.* packages are not on nuget.org. Add the feed that hosts them here (or in your user-level
       NuGet.config), e.g. <add key="poshteh" value="https://your-feed/v3/index.json" />. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
