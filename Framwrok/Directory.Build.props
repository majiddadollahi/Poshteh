<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- NuGet packaging defaults. IsPackable is off by default; each shippable src/ package opts in
       explicitly. See ../docs/FRAMEWORK.md and ../docs/ARCHITECTURE.md from the workspace root. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PoshtehVersion Condition="'$(PoshtehVersion)' == ''">10.0.1</PoshtehVersion>
    <Version>$(PoshtehVersion)</Version>
    <PackageVersion>$(PoshtehVersion)</PackageVersion>
    <AssemblyVersion>$(PoshtehVersion).0</AssemblyVersion>
    <FileVersion>$(PoshtehVersion).0</FileVersion>
    <Authors>Poshteh</Authors>
    <Company>Poshteh</Company>
    <Product>Poshteh</Product>

    <!-- Override PoshtehPackageOutputPath (or PackageOutputPath) in CI and on developer machines
         that do not use the local D: package feed. -->
    <PoshtehPackageOutputPath Condition="'$(PoshtehPackageOutputPath)' == '' and '$(OS)' == 'Windows_NT' and Exists('D:\')">D:\NuGets</PoshtehPackageOutputPath>
    <PoshtehPackageOutputPath Condition="'$(PoshtehPackageOutputPath)' == ''">$(MSBuildThisFileDirectory)artifacts\packages</PoshtehPackageOutputPath>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(PoshtehPackageOutputPath)</PackageOutputPath>
  </PropertyGroup>

</Project>
